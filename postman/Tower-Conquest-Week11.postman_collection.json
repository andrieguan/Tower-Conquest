        {
          "name": "06 - List Game Settings (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\r\npm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response contains an array of settings\", function () {\r\n    const json = pm.response.json();\r\n\r\n    pm.expect(json.data).to.be.an(\"array\");\r\n});\r\n\r\npm.test(\"Settings contain valid IDs\", function () {\r\n    const json = pm.response.json();\r\n\r\n    pm.expect(json.data.length).to.be.greaterThan(0);\r\n\r\n    json.data.forEach(function (setting) {\r\n        pm.expect(setting).to.have.property(\"setting_id\");\r\n    });\r\n});\r\n"
                ]
              }
            }
          ],
