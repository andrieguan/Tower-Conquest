      "item": [
        {
          "name": "01 - Create Game Settings (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\r\npm.test(\"Status code is 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"Response contains a setting ID\", function () {\r\n    const json = pm.response.json();\r\n\r\n    pm.expect(json.data).to.have.property(\"setting_id\");\r\n});\r\n\r\n// Save the created ID for upcoming CRUD tests.\r\nif (pm.response.code === 201) {\r\n    const json = pm.response.json();\r\n\r\n    if (json.data && json.data.setting_id) {\r\n        pm.collectionVariables.set(\r\n            \"settingId\",\r\n            json.data.setting_id\r\n        );\r\n    }\r\n}\r\n"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Demo-User",
                "value": "SCH001"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"music_volume\": 80,\r\n  \"sfx_volume\": 70,\r\n  \"is_muted\": false\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:3001/api/v1/game-settings",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3001",
